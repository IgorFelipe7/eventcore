{
  "name": "eventcore",
  "version": "0.1.0",
  "private": true,
  "description": "Capacity-limited event reservations that stay correct under concurrent pressure.",
  "license": "MIT",
  "author": "Igor Felipe",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @eventcore/db generate",
    "db:migrate": "pnpm --filter @eventcore/db migrate",
    "db:seed": "pnpm --filter @eventcore/db seed",
    "lab:record": "pnpm --filter @eventcore/tests lab:record",
    "test:e2e": "pnpm --filter @eventcore/tests exec playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
